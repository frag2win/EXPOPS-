# ExperimentOps backend configuration
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>
LOG_LEVEL=INFO
FLAGSMITH_TIMEOUT_SECONDS=10

# Flagsmith connection — keep real values in your local .env only.
FLAGSMITH_API_URL=https://api.flagsmith.com
FLAGSMITH_API_KEY=your_flagsmith_api_key_here

# Optional LLM provider configuration. Choose one provider in implementation.
LLM_PROVIDER=
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=

# Safety defaults
ALLOW_PRODUCTION_WRITES=false
REQUIRE_HUMAN_APPROVAL=true
